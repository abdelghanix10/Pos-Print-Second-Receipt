<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_print_second_receipt.SecondReceipt" owl="1">
        <div class="pos-receipt">
            <div class="pos-receipt-header" style="text-align: center; font-weight: bold;">
                SECOND RECEIPT
            </div>
            <br/>
            <div class="pos-receipt-contact">
                <div>Date: <t t-esc="props.data.date" /></div>
                <div>Order: <t t-esc="props.data.name" /></div>
            </div>
            <br />
            <div class="pos-receipt-order-data">
                <t t-foreach="props.data.orderlines" t-as="line" t-key="line.id">
                    <div style="margin-bottom: 5px;">
                        <div><t t-esc="line.product_name" /></div>
                        <div style="display: flex; justify-content: space-between;">
                            <span>Qty: <t t-esc="line.quantity" /></span>
                            <span>Price: <t t-esc="props.formatCurrency(line.price)" /></span>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
